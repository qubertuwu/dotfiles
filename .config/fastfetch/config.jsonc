{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "width": 34,
        "height": 17,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "constants": [
            "────────────────────────────────────────"
        ],
        "key": {
            "width": 14
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "os",
            "key": "󰻀 OS"
        },
        {
            "type": "kernel",
            "key": " Kernel"
        },
        {
            "type": "uptime",
            "key": "󱫐 Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "󰑭 Memory"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk (/)",
            "folders": "/"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "compactType": "original"
        },
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
